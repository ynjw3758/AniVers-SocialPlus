<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.AniVerse.Reaction.mapper.Common_mapper">

<select id="Duple_Heart" parameterType="String" resultType="boolean">
   select EXISTS (select 1 from
   likes where
   user_id=#{Id} limit 1);
</select>

<insert id="insert_heart" parameterType="java.util.HashMap">
insert into likes(content_id ,user_id ,profile_img) 
values(#{Contentid}, #{Id},#{ProfileImg});
</insert>

<insert id="Insert_Content" parameterType="String">
insert into contentinfo(contentid) values(#{contentid});
</insert>

<insert id="Insert_Userinfo" parameterType="java.util.HashMap">
insert into contentinfo(profile, userid, nickname) values(#{profile}, #{userid}, #{nickname});
</insert>

<select id ="ExistContentuser" parameterType="String" resultType="boolean">
SELECT EXISTS (
    SELECT 1
    FROM ContentInfo c, UserInfo u
    WHERE c.contentId = #{contentid}
      AND u.userId = #{UserId}
);
</select>

<insert id="Insert_Comment" parameterType="java.util.HashMap">
insert into commemts(contentid, commentid, parentkey, uniquekey, comment_text, userid)
values(#{contentid} ,#{CommentId}, #{parnetkey}, #{uniqueKey} ,#{Comments}, #{UserId})
</insert>

<delete id="delete_heart">
  DELETE FROM likes
  WHERE content_id = #{Contentid} AND user_id = #{Id}
</delete>


</mapper>