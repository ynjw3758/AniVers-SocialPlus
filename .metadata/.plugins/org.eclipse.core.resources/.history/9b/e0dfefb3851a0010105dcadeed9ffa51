package com.AniVerse.Reaction.services;

import java.time.LocalDateTime;
import java.time.temporal.ChronoUnit;
import java.util.HashMap;
import java.util.Map;

import org.apache.ibatis.session.ExecutorType;
import org.apache.ibatis.session.SqlSession;
import org.apache.ibatis.session.SqlSessionFactory;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.AniVerse.Reaction.mapper.Common_mapper;

import jakarta.transaction.Transactional;

@Service
public class Comment_Services {
	
	
	private Logger logger = LoggerFactory.getLogger(this.getClass());
	
	@Autowired
	private Common_mapper common_mapper;
	
	@Autowired
	private Generation_Services generation;
	
	@Autowired
	private  SqlSessionFactory sqlSessionFactory;
	
	public void Insert_Comment(Map<String, Object> info) {
		boolean isExsitContent =false;
		boolean isExsitUser =false;
		isExsitContent =common_mapper.ExistContent(info.get("contentid").toString());
		isExsitUser = common_mapper.ExistUser(info.get("UserId").toString());
		SqlSession sqlSession = sqlSessionFactory.openSession(ExecutorType.BATCH);
		Common_mapper mapper = sqlSession.getMapper(Common_mapper.class);
		LocalDateTime now = LocalDateTime.now().truncatedTo(ChronoUnit.SECONDS);
		info.put("insert_date", now);
		try {
		if(!isExsitContent && !isExsitUser) {
			logger.info("둘다 없다");
			mapper.Insert_Content(info);
			mapper.Insert_Userinfo(info);
			mapper.Insert_Comment(info);
		}
		else if(isExsitContent && !isExsitUser) {
			logger.info("신규 유저 댓글");
			mapper.Insert_Userinfo(info);
			mapper.Insert_Comment(info);
		}
		else if(!isExsitContent && isExsitUser) {
			logger.info("기존 고객");
			mapper.Insert_Content(info);
			mapper.Insert_Comment(info);
		}
		else if(isExsitContent && isExsitUser) {
			logger.info("둘다 존재");
			mapper.Insert_Comment(info);
		}
		
		//sqlSession.flushStatements(); // 쿼리전송
		//sqlSession.commit(); // 커밋
		//sqlSession.close(); // 닫기
		//sqlSession.clearCache(); // 캐시비우기
		}catch(Exception e) {
			logger.error("에러 발생");
		    sqlSession.rollback(); // ❗ 수동 롤백
		    throw e;
		}finally {
			 sqlSession.close();
		}
		
		
	}
	
	public Map<String, Object> Create_Comment(Map<String, Object> info) {
		Map<String, Object> result_data =new HashMap<String, Object>();
		logger.info("댓글 저장");
		String commentid = generation.Generation_uuid();
		String uniquekey = generation.Generation_uuid();
		info.put("CommentId", commentid);
		info.put("parnetkey", commentid);
		info.put("uniqueKey", uniquekey);
		logger.info("요청 데이터 정리 :" + info);
		Insert_Comment(info); //댓글 저장하기
		
		
		
		return result_data;
	}
	
	public Map<String, Object> Edit_Comment() {
		Map<String, Object> result_data =new HashMap<String, Object>();
		
		return result_data;
	}
	
	public Map<String, Object> Delete_Comment() {
		Map<String, Object> result_data =new HashMap<String, Object>();
		
		return result_data;
	}

}
