package com.AniVerse.Reaction.mongo;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.data.mongodb.core.query.Update;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;

@Service
public class Heart_Query {
	
	
	private Logger logger = LoggerFactory.getLogger(this.getClass());
	
	@Autowired
	private MongoTemplate mongo_template;
   
	@Async
	public void increate_Heart(String content_id, String user_id) {
		
		logger.info("좋아요 카운트 증가");
		Query query = Query.query(Criteria.where("_id").is(content_id));
		Update update = new Update().inc("favorite", 1);
		mongo_template.updateFirst(query, update, "Upload");
		
	}
	
	@Async
	public void decreate_Heart(String content_id, String user_id) {
		
		logger.info("좋아요 카운트 감소");
	    Query query = new Query(Criteria.where("content_id").is(content_id));
	    Update update = new Update().inc("favorite", -1);
	    mongo_template.updateFirst(query, update, "Upload");
		
	}
	

}
